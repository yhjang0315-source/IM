# 공개 테스트넷(Kaia Kairos) 데모 배포용.
# npm run keys:new 로 새로 만들고, 주소에 faucet 으로 테스트 KAIA 를 받는다.
#
# 주의: 이 키들은 배포된 프런트 번들에 그대로 들어간다. 역할 전환 데모를 위해
#       의도한 것이며, 실제 자산을 넣어서는 안 된다.
KAIROS_RPC=https://public-en-kairos.node.kaia.io
DEMO_KEY_LANDLORD=0x...
DEMO_KEY_TENANT=0x...
DEMO_KEY_GATEWAY=0x...
DEMO_KEY_MEDIATOR=0x...
